# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Full Stack FastAPI x402 Project"
STACK_NAME=full-stack-fastapi-x402-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=Grim6Easily3kept
FIRST_SUPERUSER=niccolox@devekko.com
FIRST_SUPERUSER_PASSWORD=Grim6Easily3kept

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=niccolox@devekko.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Grim6Easily3kept

SENTRY_DSN=

# x402 payments (https://github.com/x402-foundation/x402)
# Master switch. Leave false to run paid routes as ordinary free routes.
X402_ENABLED=false
# Settlement network. "base" is mainnet (real USDC); "base-sepolia" is testnet.
X402_NETWORK=base
# Wallet address that receives USDC. REQUIRED before enabling on mainnet.
X402_PAY_TO=
# Optional custom facilitator URL (blank = library default per network).
X402_FACILITATOR_URL=
# Price charged for the premium endpoint.
X402_PREMIUM_PRICE=$0.01
# Coinbase CDP credentials (stored for future facilitator use; optional today).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
